DB_HOST=your-host
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Secret for signing JWTs: at least 32 random characters (required, the API refuses to start without it)
JWT_SECRET=generate-a-long-random-secret-here
# Optional overrides (defaults: ticket-maintenance-api, ticket-maintenance-frontend, 8 hours)
# JWT_ISSUER=ticket-maintenance-api
# JWT_AUDIENCE=ticket-maintenance-frontend
# JWT_EXPIRY_HOURS=8
